{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/pedidos-compra-sync.ts": {
      "maxDuration": 60
    },
    "api/pedidos-venta-sync.ts": {
      "maxDuration": 60
    },
    "api/informe-enviar.ts": {
      "maxDuration": 60
    },
    "api/informe-cron.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/informe-cron",
      "schedule": "0 11 * * *"
    }
  ]
}
