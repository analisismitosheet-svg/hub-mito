{
  "name": "puente-sql",
  "private": true,
  "version": "1.0.0",
  "description": "Puente de solo lectura entre el SQL Server local y la PWA hub-mito (vía túnel HTTPS).",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "tareas:instalar": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/instalar-tarea.ps1",
    "tareas:quitar": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/quitar-tarea.ps1"
  },
  "dependencies": {
    "mssql": "^10.0.2"
  }
}
