# Copiar como .env y completar. Este archivo NO se sube a git.
PUENTE_TOKEN=cambiame-por-un-secreto-largo
PUENTE_PORT=3128

SQL_SERVER=TU-SERVIDOR\SQLEXPRESS
SQL_DATABASE=TuBase
SQL_USER=solo_lectura
SQL_PASSWORD=
SQL_ENCRYPT=false
SQL_TRUST_CERT=true

# Columnas habilitadas para el filtro WHERE (lista blanca, coma-separadas).
# La usa el tótem F12 para traer solo el artículo escaneado.
PUENTE_FILTRO_COLS=ARTCOD

# Sync del maestro de articulos (scripts/sync-articulos.js). Opcional:
# ARTICULOS_VISTA=DWH.dbo.vw_DIM_ARTICULO

# Nombre con que se ve el principal en el hub (opcional)
# SQL_ALIAS=ZOOLOGIC

# Segundo SQL Server (opcional). En el hub sus vistas se nombran "ALIAS:BASE.esquema.objeto".
# SQL2_ALIAS=DESKTOP-OA4GU6I
# SQL2_SERVER=localhost
# SQL2_DATABASE=VISTAS_CONSOLIDADAS
# SQL2_WINDOWS_AUTH=true            # usuario de Windows del puente (driver ODBC 18 + msnodesqlv8)
# SQL2_USER=solo_lectura            # o login SQL
# SQL2_PASSWORD=
