# Supabase del HUB (login compartido).
# Podés apuntar a un proyecto existente o crear uno nuevo solo para el hub.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# URLs de las PWAs externas a las que enlaza el menú.
# Dejá vacío para que la tarjeta muestre "próximamente".
VITE_URL_TRANSPORTE=
VITE_URL_CONTROL_LOCALES=

# ---- Datos SQL (lectura en vivo del SQL Server vía Logic App + Gateway) ----
# Fallback opcional: se usa solo si todavía no cargaste vistas desde
# Configuraciones > Conexión SQL (que las guarda en config_app, sin redeploy).
VITE_SQL_VISTAS=vw_stock|Stock,vw_precios|Precios
#
# Vista de "salidas": reporta qué artículos YA se remitieron desde el SQL Server
# local (columnas: origen/local, articulo, color, talle). La PWA la consulta en
# bucle en Reposiciones/Transferencias y marca automáticamente como "hecho" los
# artículos que coinciden, para que el usuario no tenga que tildarlos uno por uno.
# Se puede configurar también desde Configuraciones > Conexión SQL (clave
# 'sql_vista_salidas'), que tiene prioridad sobre esta variable.
VITE_SQL_VISTA_SALIDAS=vw_salidas
#
# Solo en Vercel (Environment Variables, SIN prefijo VITE_):
#   SUPABASE_URL                = https://TU-PROYECTO.supabase.co
#   SUPABASE_ANON_KEY           = tu-anon-key
#   SUPABASE_SERVICE_ROLE_KEY   = service role key (necesaria: las funciones leen
#                                 sql_conexion y config_app bypaseando RLS)
#   SQL_LOGICAPP_URL            = fallback si no guardaste la URL en Configuraciones
#   SQL_VIEWS                   = whitelist fija opcional (vw_stock,vw_precios)
#   SQL_MAX_ROWS                = fallback del tope de filas (default 1000)
#   SQL_BRIDGE_TOKEN            = mismo secreto que PUENTE_TOKEN del Puente SQL
#                                 local (el Logic App lo ignora)
#
# Cruce Facturación Fábrica <-> Bultos recibidos (transporte):
#   TRANSPORTE_URL              = https://lrizsqpefuprmrwbtbtu.supabase.co (Supabase de transporte)
#   TRANSPORTE_ANON_KEY         = anon key de transporte (pública)
#   MITO_CRUCE_KEY              = mismo valor que el secret 'MITO_CRUCE_KEY' de la
#                                 edge function bultos-recibidos en transporte
#                                 (setear con: supabase secrets set MITO_CRUCE_KEY=...)
#
# Prioridad: lo configurado en la app (Conexión SQL) > variables de entorno.
