# Supabase del HUB (login compartido).
# Podés apuntar a un proyecto existente o crear uno nuevo solo para el hub.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# URLs de las PWAs externas a las que enlaza el menú.
# Dejá vacío para que la tarjeta muestre "próximamente".
VITE_URL_TRANSPORTE=
VITE_URL_CONTROL_LOCALES=

# ---- Datos SQL (lectura en vivo del SQL Server vía Logic App + Gateway) ----
# Fallback opcional: se usa solo si todavía no cargaste vistas desde
# Configuraciones > Conexión SQL (que las guarda en config_app, sin redeploy).
VITE_SQL_VISTAS=vw_stock|Stock,vw_precios|Precios
#
# Solo en Vercel (Environment Variables, SIN prefijo VITE_):
#   SUPABASE_URL       = https://TU-PROYECTO.supabase.co
#   SUPABASE_ANON_KEY  = tu-anon-key
#   SQL_LOGICAPP_URL   = URL completa del trigger HTTP del Logic App (incluye sp/sv/sig)
#   SQL_VIEWS          = vw_stock,vw_precios
#   SQL_MAX_ROWS       = 1000
